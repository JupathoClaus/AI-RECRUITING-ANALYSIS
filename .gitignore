# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# development server logs
dev-server*.log
dev_output.log
backend-startup.log
backend/serve.log
/.runtime/

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# frontend runtime logs
frontend-output.log
smoke-*.png

# verification log files (held open by running processes)
verification/**/backend.out.log
verification/**/backend.err.log
verification/**/frontend.out.log
verification/**/frontend.err.log
verification/next-*.log
verification/reports/browser-proof-*.md
verification/reports/product-proof-*.md

# verification runtime logs (generated by proof runs, never commit)
verification/*.out.log
verification/*.err.log
verification/product-proof-run.log
verification/runtime-*.log
verification/dev-*.log
