# TalentAI Staging Environment Configuration
#
# Copy this file to .env.staging and fill in real values.
# NEVER commit the .env.staging file with real secrets.
#
# Generate strong JWT secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ── Database ───────────────────────────────────────────────────────
POSTGRES_USER=talentai
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=talentai_staging

# ── JWT Authentication (REQUIRED — app will not start without these) ──
JWT_SECRET=replace-with-96-hex-chars-min
JWT_REFRESH_SECRET=replace-with-different-96-hex-chars-min

# ── Assessment Access Token (REQUIRED — app will not start without this) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ASSESSMENT_ACCESS_TOKEN_SECRET=replace-with-96-hex-chars-min

# ── Frontend URL ───────────────────────────────────────────────────
# Staging uses port 3011 (dev frontend is on 3001, staging backend on 3010)
FRONTEND_URL=http://localhost:3011
CORS_ORIGIN=http://localhost:3011

# ── Email ─────────────────────────────────────────────────────────
EMAIL_FROM=noreply@ai-recruiter.com

# ── AI Providers (all MOCK by default for staging safety) ──────────
AI_SCREENING_PROVIDER=mock
# To use real Qwen inference (requires Ollama running):
# AI_SCREENING_PROVIDER=qwen
# QWEN_BASE_URL=http://host.docker.internal:11434/v1
# QWEN_MODEL=qwen3.5:9b
# QWEN_API_KEY=ollama
