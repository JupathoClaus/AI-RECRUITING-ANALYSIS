NODE_ENV=test
APP_NAME=TalentAI
APP_VERSION=1.0.0
APP_PORT=3000
API_PREFIX=api
API_VERSION=v1
FRONTEND_URL=http://localhost:3001
REQUEST_TIMEOUT_MS=30000
HEALTH_CHECK_TIMEOUT_MS=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/talentai_test?schema=public
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=talentai_test:
JWT_SECRET=test-jwt-secret-that-is-at-least-32-chars!!
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=test-refresh-secret-that-is-at-least-32-chars
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=talentai-api
JWT_AUDIENCE=talentai-recruiter-web
BCRYPT_ROUNDS=10
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=15
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_VERIFICATION_TOKEN_TTL_MINUTES=1440
AUTH_PASSWORD_RESET_TOKEN_TTL_MINUTES=30
AUTH_SESSION_LIMIT_PER_USER=10
REFRESH_TOKEN_COOKIE_NAME=talentai_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=lax
CORS_ORIGIN=http://localhost:3001
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=1000
SWAGGER_ENABLED=false
LOG_LEVEL=silent
