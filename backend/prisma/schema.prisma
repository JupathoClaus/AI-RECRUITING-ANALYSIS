  authorMembershipId String
  content            String
  visibility         CandidateNoteVisibility @default(PRIVATE)
  editedAt           DateTime?
  deletedAt          DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  company          Company           @relation(fields: [companyId], references: [id])
  companyCandidate CompanyCandidate  @relation(fields: [companyCandidateId], references: [id], onDelete: Cascade)
  author           CompanyMembership @relation("CandidateNoteAuthor", fields: [authorMembershipId], references: [id])

  @@index([companyCandidateId])
  @@index([companyId])
  @@index([authorMembershipId])
  @@index([deletedAt])
}

// ─── ApplicationCounter ───────────────────────────────────────────────────────

model ApplicationCounter {
  id        String   @id @default(uuid())
  companyId String
  year      Int
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, year])
  @@index([companyId])
}

// ─── Application ──────────────────────────────────────────────────────────────

model Application {
  id                     String            @id @default(uuid())
  companyId              String
  jobId                  String
  candidateId            String
  companyCandidateId     String
  applicationNumber      String
  publicReference        String            @unique
  status                 ApplicationStatus @default(DRAFT)
  currentStageId         String?
  source                 CandidateSource
  sourceDetail           String?
  submittedAt            DateTime?
  withdrawnAt            DateTime?
  withdrawalReason       String?
  rejectedAt             DateTime?
  rejectionReasonCode    String?
  rejectionReasonDetails String?
  disqualifiedAt         DateTime?
  hiredAt                DateTime?
  archivedAt             DateTime?
  coverLetter            String?
  expectedSalaryMin      Decimal?
  expectedSalaryMax      Decimal?
  salaryCurrency         String?
  availabilityDate       DateTime?
  noticePeriodDays       Int?
  referralMembershipId   String?
  referralName           String?
  referralEmail          String?
  consentConfirmed       Boolean           @default(false)
  candidateSnapshot      Json?
  jobSnapshot            Json?
  screeningSnapshot      Json?
  version                Int               @default(1)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  deletedAt              DateTime?

  company          Company            @relation(fields: [companyId], references: [id])
  job              Job                @relation(fields: [jobId], references: [id])
  candidate        Candidate          @relation(fields: [candidateId], references: [id])
  companyCandidate CompanyCandidate   @relation(fields: [companyCandidateId], references: [id])
  currentStage     JobPipelineStage?  @relation("ApplicationCurrentStage", fields: [currentStageId], references: [id])
  referral         CompanyMembership? @relation("ApplicationReferral", fields: [referralMembershipId], references: [id])

  screeningAnswers ApplicationScreeningAnswer[]
  stageHistory     ApplicationStageHistory[]
  assignments      ApplicationAssignment[]
  notes            ApplicationNote[]
  flags            ApplicationFlag[]
  decisions        ApplicationDecision[]
  tagAssignments   ApplicationTagAssignment[]

  // Phase 2.3
  interviews Interview[]

  // Phase 2B
  resumeFiles StoredFile[]

  // Phase 4 — AI Screening
  aiScreeningResults AiScreeningResult[]

  // Phase 5 — AI Interviews
  aiInterviews AiInterview[]

  @@unique([companyId, applicationNumber])
  @@index([companyId])
  @@index([jobId])
  @@index([candidateId])
  @@index([companyCandidateId])
  @@index([status])
  @@index([currentStageId])
  @@index([applicationNumber])
  @@index([publicReference])
  @@index([submittedAt])
  @@index([createdAt])
}

// ─── StoredFile ───────────────────────────────────────────────────────────────

enum FileCategory {
  RESUME
  COMPANY_LOGO
  COVER_IMAGE
  SCREENING_ANSWER
}

enum FileStatus {
  ACTIVE
  SUPERSEDED
  DELETED
}

model StoredFile {
  id               String       @id @default(uuid())
  companyId        String
  applicationId    String?
  uploadedByUserId String?
  storageKey       String       @unique
  originalName     String
  storedName       String
  extension        String
  mimeType         String
  sizeBytes        Int
  checksumSha256   String
  category         FileCategory
  status           FileStatus   @default(ACTIVE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  application Application? @relation(fields: [applicationId], references: [id])

  // Phase 4 — AI Screening
  textExtractions ResumeTextExtraction[]

  @@index([companyId])
  @@index([applicationId])
  @@index([category])
  @@index([status])
  @@index([checksumSha256])
  @@index([createdAt])
  @@index([deletedAt])
}

// ─── ApplicationTagAssignment ─────────────────────────────────────────────────

model ApplicationTagAssignment {
  id                     String   @id @default(uuid())
  applicationId          String
  tagId                  String
  assignedByMembershipId String
  assignedAt             DateTime @default(now())

  application Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tag         CandidateTag      @relation(fields: [tagId], references: [id])
  assignedBy  CompanyMembership @relation("AppTagAssignedBy", fields: [assignedByMembershipId], references: [id])

  @@unique([applicationId, tagId])
  @@index([applicationId])
  @@index([tagId])
}

// ─── ApplicationScreeningAnswer ───────────────────────────────────────────────

model ApplicationScreeningAnswer {
  id                   String    @id @default(uuid())
  applicationId        String
  questionId           String
  answer               Json?
  textAnswer           String?
  numericAnswer        Decimal?
  dateAnswer           DateTime?
  fileId               String?
  answeredAt           DateTime  @default(now())
  isComplete           Boolean   @default(false)
  recruiterReviewed    Boolean   @default(false)
  recruiterReviewNotes String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  application Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question    JobScreeningQuestion @relation(fields: [questionId], references: [id])

  @@unique([applicationId, questionId])
  @@index([applicationId])
  @@index([questionId])
}

// ─── ApplicationStageHistory ──────────────────────────────────────────────────

model ApplicationStageHistory {
  id                String               @id @default(uuid())
  applicationId     String
  fromStageId       String?
  toStageId         String
  fromStatus        ApplicationStatus?
  toStatus          ApplicationStatus
  actorType         ApplicationActorType
  actorUserId       String?
  actorMembershipId String?
  reasonCode        String?
  notes             String?
  occurredAt        DateTime             @default(now())

  application Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStage   JobPipelineStage? @relation("HistoryFromStage", fields: [fromStageId], references: [id])
  toStage     JobPipelineStage  @relation("HistoryToStage", fields: [toStageId], references: [id])

  @@index([applicationId])
  @@index([occurredAt])
}

// ─── ApplicationAssignment ────────────────────────────────────────────────────

model ApplicationAssignment {
  id                     String                    @id @default(uuid())
  applicationId          String
  membershipId           String
  type                   ApplicationAssignmentType
  assignedByMembershipId String
  assignedAt             DateTime                  @default(now())
  removedAt              DateTime?

  application Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  membership  CompanyMembership @relation("ApplicationAssignee", fields: [membershipId], references: [id])
  assignedBy  CompanyMembership @relation("ApplicationAssigner", fields: [assignedByMembershipId], references: [id])

  @@index([applicationId])
  @@index([membershipId])
  @@index([type])
}

// ─── ApplicationNote ──────────────────────────────────────────────────────────

model ApplicationNote {
  id                 String                  @id @default(uuid())
  applicationId      String
  companyId          String
  authorMembershipId String
  content            String
  visibility         CandidateNoteVisibility @default(PRIVATE)
  editedAt           DateTime?
  deletedAt          DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  application Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  company     Company           @relation(fields: [companyId], references: [id])
  author      CompanyMembership @relation("ApplicationNoteAuthor", fields: [authorMembershipId], references: [id])

  @@index([applicationId])
  @@index([companyId])
  @@index([deletedAt])
}

// ─── ApplicationFlag ──────────────────────────────────────────────────────────

model ApplicationFlag {
  id                     String                  @id @default(uuid())
  applicationId          String
  type                   ApplicationFlagType
  description            String?
  severity               ApplicationFlagSeverity @default(MEDIUM)
  createdByActorType     ApplicationActorType
  createdByUserId        String?
  createdByMembershipId  String?
  resolved               Boolean                 @default(false)
  resolvedByMembershipId String?
  resolvedAt             DateTime?
  resolutionNotes        String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  application Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  resolvedBy  CompanyMembership? @relation("FlagResolvedBy", fields: [resolvedByMembershipId], references: [id])
  createdBy   CompanyMembership? @relation("FlagCreatedBy", fields: [createdByMembershipId], references: [id])

  @@index([applicationId])
  @@index([resolved])
  @@index([type])
}

// ─── ApplicationDecision ─────────────────────────────────────────────────────

model ApplicationDecision {
  id                   String                  @id @default(uuid())
  applicationId        String
  type                 ApplicationDecisionType
  actorType            ApplicationActorType
  actorUserId          String?
  actorMembershipId    String?
  reasonCode           String?
  explanation          String
  score                Decimal?
  confidence           Decimal?
  evidence             Json?
  aiProvider           String?
  aiModel              String?
  overriddenDecisionId String?
  finalDecision        Boolean                 @default(false)
  createdAt            DateTime                @default(now())

  application        Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorMembership    CompanyMembership?    @relation("DecisionActor", fields: [actorMembershipId], references: [id])
  overriddenDecision ApplicationDecision?  @relation("DecisionOverride", fields: [overriddenDecisionId], references: [id])
  overrides          ApplicationDecision[] @relation("DecisionOverride")

  @@index([applicationId])
  @@index([type])
  @@index([finalDecision])
}

// ─── AiScreeningResult ────────────────────────────────────────────────────────
// Phase 4 — AI Resume Screening Engine

enum AiScreeningStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum AiScreeningRecommendation {
  SHORTLIST
  NOT_SHORTLIST
  HUMAN_REVIEW
}

enum AiScreeningConfidence {
  LOW
  MEDIUM
  HIGH
}

model AiScreeningResult {
  id                          String                     @id @default(uuid())
  applicationId               String
  jobId                       String
  candidateId                 String
  companyId                   String
  initiatedByUserId           String
  status                      AiScreeningStatus          @default(PENDING)
  overallScore                Int?
  recommendation              AiScreeningRecommendation?
  confidence                  AiScreeningConfidence?
  matchedQualifications       Json?
  missingQualifications       Json?
  evidence                    Json?
  criteriaScores              Json?
  uncertainties               Json?
  riskFlags                   Json?
  explanation                 String?
  prohibitedReasoningDetected Boolean                    @default(false)
  provider                    String?
  model                       String?
  promptVersion               String?
  providerResponseId          String?
  inputFingerprint            String?
  failureCode                 String?
  failureMessageSafe          String?
  startedAt                   DateTime?
  completedAt                 DateTime?
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt

  application Application @relation(fields: [applicationId], references: [id])

  @@index([applicationId])
  @@index([companyId])
  @@index([status])
  @@index([createdAt])
  @@index([recommendation])
  @@index([applicationId, createdAt])
}

// ─── ResumeTextExtraction ────────────────────────────────────────────────────
// Phase 4 — Resume Text Extraction Pipeline

enum ResumeExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ExtractionDispatchStatus {
  PENDING_DISPATCH
  DISPATCHING
  DISPATCHED
  DISPATCH_FAILED
}

model ResumeTextExtraction {
  id                  String                 @id @default(uuid())
  storedFileId        String
  companyId           String
  initiatedByUserId   String?
  status              ResumeExtractionStatus @default(PENDING)
  extractedText       String?
  extractedTextSha256 String?
  sourceFileSha256    String?
  parserName          String?
  parserVersion       String?
  mimeType            String?
  failureCode         String?
  failureMessageSafe  String?
  retryGeneration     Int?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  storedFile StoredFile          @relation(fields: [storedFileId], references: [id])
  dispatch   ExtractionDispatch?

  @@index([storedFileId])
  @@index([companyId])
  @@index([status])
  @@index([storedFileId, companyId, status])
  @@index([createdAt])
}

model ExtractionDispatch {
  id               String                   @id @default(uuid())
  extractionId     String                   @unique
  dispatchStatus   ExtractionDispatchStatus @default(PENDING_DISPATCH)
  dispatchToken    String?
  jobId            String?
  dispatchAttempts Int                      @default(0)
  lastErrorCode    String?
  leaseStartedAt   DateTime?
  nextAttemptAt    DateTime?
  dispatchedAt     DateTime?
  dispatchFailedAt DateTime?
  failureCode      String?
  failureMessage   String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  extraction ResumeTextExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)

  @@index([dispatchStatus])
  @@index([dispatchToken])
  @@index([dispatchStatus, nextAttemptAt])
  @@index([dispatchStatus, leaseStartedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// PHASE 2.3 — INTERVIEW SCHEDULING
// ─────────────────────────────────────────────────────────────────────────────

enum InterviewType {
  PHONE
  VIDEO
  ONSITE
  TECHNICAL
  HR
  PANEL
  FINAL
  AI
}

enum InterviewStatus {
  SCHEDULED
  CONFIRMED
  RESCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  EXPIRED
}

enum InterviewResult {
  PASS
  FAIL
  HOLD
  PENDING
  NOT_RECORDED
}

enum InterviewParticipantRole {
  INTERVIEWER
  HIRING_MANAGER
  RECRUITER
  CANDIDATE
  PANELIST
  OBSERVER
  NOTE_TAKER
  COORDINATOR
}

enum InterviewParticipantStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum InterviewHistoryEventType {
  INTERVIEW_SCHEDULED
  INTERVIEW_RESCHEDULED
  INTERVIEW_CONFIRMED
  INTERVIEW_CANCELLED
  INTERVIEW_STARTED
  INTERVIEW_COMPLETED
  INTERVIEW_NO_SHOW
  INTERVIEW_RESULT_RECORDED
  INTERVIEW_RESULT_CHANGED
  PARTICIPANT_ADDED
  PARTICIPANT_REMOVED
  PARTICIPANT_STATUS_CHANGED
  INTERVIEW_EXPIRED
  INTERVIEW_UPDATED
}

model Interview {
  id                    String          @id @default(uuid())
  companyId             String
  applicationId         String
  jobId                 String
  jobPipelineStageId    String?
  type                  InterviewType
  status                InterviewStatus @default(SCHEDULED)
  result                InterviewResult @default(NOT_RECORDED)
  title                 String
  description           String?
  location              String?
  meetingLink           String?
  meetingProvider       String?
  meetingId             String?
  scheduledAt           DateTime
  durationMinutes       Int
  timezone              String          @default("UTC")
  language              String          @default("en")
  notes                 String?
  privateNotes          String?
  cancelReason          String?
  completedAt           DateTime?
  resultNotes           String?
  resultReasonCode      String?
  configuration         Json?
  version               Int             @default(1)
  createdByMembershipId String
  updatedByMembershipId String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  deletedAt             DateTime?

  company     Company            @relation(fields: [companyId], references: [id])
  application Application        @relation(fields: [applicationId], references: [id])
  job         Job                @relation(fields: [jobId], references: [id])
  stage       JobPipelineStage?  @relation(fields: [jobPipelineStageId], references: [id])
  createdBy   CompanyMembership  @relation("InterviewCreatedBy", fields: [createdByMembershipId], references: [id])
  updatedBy   CompanyMembership? @relation("InterviewUpdatedBy", fields: [updatedByMembershipId], references: [id])

  participants InterviewParticipant[]
  history      InterviewHistory[]

  @@index([companyId])
  @@index([applicationId])
  @@index([jobId])
  @@index([jobPipelineStageId])
  @@index([status])
  @@index([type])
  @@index([scheduledAt])
  @@index([createdByMembershipId])
  @@index([createdAt])
}

model InterviewParticipant {
  id                  String                     @id @default(uuid())
  interviewId         String
  membershipId        String?
  email               String?
  firstName           String?
  lastName            String?
  role                InterviewParticipantRole
  status              InterviewParticipantStatus @default(PENDING)
  isRequired          Boolean                    @default(true)
  sortOrder           Int                        @default(0)
  notes               String?
  respondedAt         DateTime?
  externalCalendarId  String?
  addedByMembershipId String
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  interview  Interview          @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  membership CompanyMembership? @relation("InterviewParticipantMembership", fields: [membershipId], references: [id])
  addedBy    CompanyMembership  @relation("InterviewParticipantAddedBy", fields: [addedByMembershipId], references: [id])

  @@unique([interviewId, membershipId])
  @@index([interviewId])
  @@index([membershipId])
  @@index([role])
  @@index([status])
}

model InterviewHistory {
  id                String                    @id @default(uuid())
  interviewId       String
  eventType         InterviewHistoryEventType
  actorUserId       String?
  actorMembershipId String?
  description       String
  metadata          Json?
  requestId         String?
  occurredAt        DateTime                  @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
  @@index([eventType])
  @@index([occurredAt])
}

// ─── ApplicationAuditEvent ────────────────────────────────────────────────────

model ApplicationAuditEvent {
  id                 String                    @id @default(uuid())
  companyId          String
  applicationId      String?
  companyCandidateId String?
  candidateId        String?
  actorUserId        String?
  actorMembershipId  String?
  actorType          ApplicationActorType
  eventType          ApplicationAuditEventType
  entityType         String
  entityId           String?
  description        String
  metadata           Json?
  requestId          String?
  occurredAt         DateTime                  @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([applicationId])
  @@index([companyCandidateId])
  @@index([eventType])
  @@index([occurredAt])
}

// ─── AI Interview Enums ────────────────────────────────────────────────────────

enum AiInterviewStatus {
  CREATED
  SENT
  ACCESSED
  READY
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
  FAILED
}

enum AiInterviewProvider {
  MOCK
  TAVUS
}

enum AiInterviewTranscriptStatus {
  NOT_REQUESTED
  PENDING
  READY
  FAILED
}

// ─── AI Interview Model ────────────────────────────────────────────────────────

model AiInterview {
  id            String              @id @default(uuid())
  applicationId String
  companyId     String
  provider      AiInterviewProvider @default(TAVUS)
  status        AiInterviewStatus   @default(CREATED)

  // Interview code
  codeHash        String
  codeDisplayHint String?

  // Invitation tracking
  invitationSentAt DateTime?
  invitationEmail  String?

  // Access tracking
  accessedAt DateTime?

  // Interview execution
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  // Tavus integration
  tavusConversationId  String?
  tavusConversationUrl String?
  tavusStatus          String?
  tavusMeetingToken    String?

  // Transcript
  transcriptStatus AiInterviewTranscriptStatus @default(NOT_REQUESTED)
  transcriptUrl    String?

  // Config
  language                 String    @default("en")
  estimatedDurationMinutes Int       @default(30)
  availableFrom            DateTime?
  expiresAt                DateTime?

  // Notes
  notes                   String?
  cancelledByMembershipId String?

  // Relations
  application           Application        @relation(fields: [applicationId], references: [id])
  company               Company            @relation(fields: [companyId], references: [id])
  createdByMembershipId String?
  createdBy             CompanyMembership? @relation("AiInterviewCreatedBy", fields: [createdByMembershipId], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([codeHash])
  @@index([applicationId])
  @@index([companyId])
  @@index([status])
  @@index([tavusConversationId])
  @@index([expiresAt])
}
