generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED
  LOCKED
  DELETED
}

enum CompanyStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum RoleScope {
  PLATFORM
  COMPANY
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  COMPANY_INVITATION
  EMAIL_CHANGE
}

enum AuditEventType {
  USER_REGISTERED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  ACCOUNT_LOCKED
  LOGOUT
  LOGOUT_ALL
  TOKEN_REFRESHED
  REFRESH_TOKEN_REUSE_DETECTED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_VERIFICATION_SENT
  EMAIL_VERIFIED
  SESSION_REVOKED
  ROLE_ASSIGNED
  PERMISSION_DENIED
  COMPANY_SELECTED
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum LocationType {
  HEAD_OFFICE
  BRANCH
  REMOTE
  CLIENT_SITE
  OTHER
}

enum LocationStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum OrganizationAuditEventType {
  COMPANY_PROFILE_UPDATED
  COMPANY_SETTINGS_UPDATED
  DEPARTMENT_CREATED
  DEPARTMENT_UPDATED
  DEPARTMENT_ARCHIVED
  DEPARTMENT_RESTORED
  LOCATION_CREATED
  LOCATION_UPDATED
  LOCATION_ARCHIVED
  LOCATION_RESTORED
  MEMBER_INVITED
  INVITATION_RESENT
  INVITATION_REVOKED
  INVITATION_ACCEPTED
  MEMBER_ROLE_CHANGED
  MEMBER_SUSPENDED
  MEMBER_REACTIVATED
  MEMBER_REMOVED
  MEMBER_DEPARTMENT_ASSIGNED
  MEMBER_DEPARTMENT_REMOVED
  ONBOARDING_COMPLETED
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_DELETED
}

model SystemMetadata {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model User {
  id                  String     @id @default(uuid())
  email               String
  normalizedEmail     String     @unique
  passwordHash        String
  firstName           String
  lastName            String
  phone               String?
  avatarUrl           String?
  status              UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime?
  preferredLocale     String     @default("en")
  timezone            String     @default("UTC")
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  memberships        CompanyMembership[]
  sessions           UserSession[]
  verificationTokens VerificationToken[]
  authAuditEvents    AuthAuditEvent[]
  invitedInvitations CompanyInvitation[]
  notifications      UserNotification[]

  @@index([status])
  @@index([createdAt])
}

model Company {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  status      CompanyStatus @default(ACTIVE)
  emailDomain String?
  logoUrl     String?
  country     String?
  timezone    String        @default("UTC")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  legalName             String?
  registrationNumber    String?
  taxNumber             String?
  industry              String?
  companySize           String?
  website               String?
  phone                 String?
  supportEmail          String?
  description           String?
  addressLine1          String?
  addressLine2          String?
  city                  String?
  stateOrProvince       String?
  postalCode            String?
  countryCode           String?
  defaultLanguage       String    @default("en")
  dateFormat            String    @default("YYYY-MM-DD")
  timeFormat            String    @default("HH:mm")
  currencyCode          String?
  recruitmentEmail      String?
  logoFileId            String?
  coverImageFileId      String?
  onboardingCompletedAt DateTime?
  createdByUserId       String?
  updatedByUserId       String?

  memberships       CompanyMembership[]
  roles             Role[]
  authAuditEvents   AuthAuditEvent[]
  invitations       CompanyInvitation[]
  departments       Department[]
  locations         CompanyLocation[]
  settings          CompanySettings?
  auditEvents       OrganizationAuditEvent[]
  jobs              Job[]
  jobTemplates      JobTemplate[]
  skills            Skill[]
  jobActivityEvents JobActivityEvent[]

  // Phase 2.2
  companyCandidates      CompanyCandidate[]
  candidateTags          CandidateTag[]
  companyCandidateNotes  CompanyCandidateNote[]
  applicationCounters    ApplicationCounter[]
  applications           Application[]
  applicationNotes       ApplicationNote[]
  applicationAuditEvents ApplicationAuditEvent[]

  // Phase 2.3
  interviews Interview[]

  // Phase 2.4
  notifications UserNotification[]

  // Phase 5 — AI Interviews
  aiInterviews AiInterview[]

  @@index([status])
  @@index([industry])
  @@index([createdAt])
}

model Role {
  id          String    @id @default(uuid())
  code        String
  name        String
  description String?
  scope       RoleScope
  isSystem    Boolean   @default(false)
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  memberships     CompanyMembership[]
  rolePermissions RolePermission[]
  invitations     CompanyInvitation[]

  @@unique([code, scope])
  @@index([scope])
  @@index([companyId])
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  resource    String
  action      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model CompanyMembership {
  id              String           @id @default(uuid())
  userId          String
  companyId       String
  roleId          String
  status          MembershipStatus @default(ACTIVE)
  jobTitle        String?
  invitedByUserId String?
  invitedAt       DateTime?
  joinedAt        DateTime?
  lastActiveAt    DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])

  departmentMemberships   DepartmentMembership[]
  managedDepartments      Department[]
  invitations             CompanyInvitation[]
  ownedJobs               Job[]                       @relation("JobOwner")
  createdJobs             Job[]                       @relation("JobCreatedBy")
  updatedJobs             Job[]                       @relation("JobUpdatedBy")
  templateCreations       JobTemplate[]               @relation("TemplateCreatedBy")
  templateUpdates         JobTemplate[]               @relation("TemplateUpdatedBy")
  pipelineCreations       JobPipeline[]               @relation("PipelineCreatedBy")
  pipelineUpdates         JobPipeline[]               @relation("PipelineUpdatedBy")
  approvalRequests        JobApproval[]               @relation("ApprovalRequestedBy")
  approvalAssignments     JobApproval[]               @relation("ApprovalAssignedTo")
  approvalReviews         JobApproval[]               @relation("ApprovalReviewedBy")
  jobCollaborators        JobCollaborator[]
  collaboratorAssignments JobCollaborator[]           @relation("CollaboratorAssignedBy")
  jobPublicationRequests  JobPublication[]
  screeningConfigUpdates  JobScreeningConfiguration[] @relation("ScreeningConfigUpdatedBy")

  // Phase 2.2
  ownedCompanyCandidates   CompanyCandidate[]         @relation("CompanyCandidateOwner")
  createdCompanyCandidates CompanyCandidate[]         @relation("CompanyCandidateCreatedBy")
  updatedCompanyCandidates CompanyCandidate[]         @relation("CompanyCandidateUpdatedBy")
  createdCandidateTags     CandidateTag[]             @relation("TagCreatedBy")
  assignedCandidateTags    CompanyCandidateTag[]      @relation("CandidateTagAssignedBy")
  authoredCandidateNotes   CompanyCandidateNote[]     @relation("CandidateNoteAuthor")
  referredApplications     Application[]              @relation("ApplicationReferral")
  assignedApplicationTags  ApplicationTagAssignment[] @relation("AppTagAssignedBy")
  applicationAssignments   ApplicationAssignment[]    @relation("ApplicationAssignee")
  applicationAssigned      ApplicationAssignment[]    @relation("ApplicationAssigner")
  authoredApplicationNotes ApplicationNote[]          @relation("ApplicationNoteAuthor")
  resolvedFlags            ApplicationFlag[]          @relation("FlagResolvedBy")
  createdFlags             ApplicationFlag[]          @relation("FlagCreatedBy")
  applicationDecisions     ApplicationDecision[]      @relation("DecisionActor")

  // Phase 2.3
  createdInterviews          Interview[]            @relation("InterviewCreatedBy")
  updatedInterviews          Interview[]            @relation("InterviewUpdatedBy")
  participantMemberships     InterviewParticipant[] @relation("InterviewParticipantMembership")
  addedInterviewParticipants InterviewParticipant[] @relation("InterviewParticipantAddedBy")

  // Phase 5 — AI Interviews
  createdAiInterviews AiInterview[] @relation("AiInterviewCreatedBy")

  sessions UserSession[]

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([roleId])
  @@index([status])
}

model UserSession {
  id                       String        @id @default(uuid())
  userId                   String
  activeCompanyId          String?
  membershipId             String?
  refreshTokenHash         String
  refreshTokenFamilyId     String
  previousRefreshTokenHash String?
  status                   SessionStatus @default(ACTIVE)
  ipAddress                String?
  userAgent                String?
  deviceName               String?
  lastUsedAt               DateTime      @default(now())
  expiresAt                DateTime
  revokedAt                DateTime?
  revokeReason             String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  user       User               @relation(fields: [userId], references: [id])
  membership CompanyMembership? @relation(fields: [membershipId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([refreshTokenFamilyId])
  @@index([membershipId])
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model IdempotencyKey {
  id                  String            @id @default(uuid())
  key                 String
  companyId           String
  userId              String
  operation           String
  requestHash         String?
  status              IdempotencyStatus @default(PROCESSING)
  resourceType        String
  resourceId          String
  responseJson        Json?
  leaseToken          String?
  processingStartedAt DateTime?
  expiresAt           DateTime
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([key, companyId, userId, operation])
  @@index([key, companyId, userId, operation, status])
  @@index([companyId])
  @@index([expiresAt])
  @@index([leaseToken])
}

model VerificationToken {
  id        String                @id @default(uuid())
  userId    String?
  email     String
  type      VerificationTokenType
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int                   @default(0)
  createdAt DateTime              @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([userId])
  @@index([type])
  @@index([expiresAt])
}

model AuthAuditEvent {
  id         String         @id @default(uuid())
  userId     String?
  companyId  String?
  sessionId  String?
  eventType  AuditEventType
  success    Boolean
  ipAddress  String?
  userAgent  String?
  requestId  String?
  metadata   Json?
  occurredAt DateTime       @default(now())

  user    User?    @relation(fields: [userId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])

  @@index([userId])
  @@index([companyId])
  @@index([eventType])
  @@index([occurredAt])
}

model UserNotification {
  id                String           @id @default(uuid())
  userId            String
  companyId         String?
  type              NotificationType
  title             String
  body              String?
  readAt            DateTime?
  relatedEntityType String?
  relatedEntityId   String?
  actionUrl         String?
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user    User?    @relation(fields: [userId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([companyId])
  @@index([type])
}

enum NotificationType {
  APPLICATION_SUBMITTED
  APPLICATION_STAGE_CHANGED
  INTERVIEW_SCHEDULED
  INTERVIEW_RESCHEDULED
  INTERVIEW_CANCELLED
  INTERVIEW_COMPLETED
  INVITATION_SENT
  INVITATION_ACCEPTED
  CANDIDATE_HIRED
  CANDIDATE_REJECTED
  NOTE_ADDED
  AI_SCREENING_COMPLETED
  SYSTEM
}

model Department {
  id                  String           @id @default(uuid())
  companyId           String
  name                String
  code                String?
  description         String?
  parentDepartmentId  String?
  managerMembershipId String?
  status              DepartmentStatus @default(ACTIVE)
  sortOrder           Int              @default(0)
  createdByUserId     String
  updatedByUserId     String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?

  company               Company                @relation(fields: [companyId], references: [id])
  parentDepartment      Department?            @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  childDepartments      Department[]           @relation("DepartmentHierarchy")
  managerMembership     CompanyMembership?     @relation(fields: [managerMembershipId], references: [id])
  departmentMemberships DepartmentMembership[]
  invitations           CompanyInvitation[]
  Job                   Job[]
  JobTemplate           JobTemplate[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([status])
  @@index([parentDepartmentId])
  @@index([managerMembershipId])
}

model CompanyLocation {
  id              String         @id @default(uuid())
  companyId       String
  name            String
  type            LocationType   @default(HEAD_OFFICE)
  addressLine1    String
  addressLine2    String?
  city            String
  stateOrProvince String?
  postalCode      String?
  countryCode     String
  timezone        String         @default("UTC")
  phone           String?
  email           String?
  latitude        Float?
  longitude       Float?
  isPrimary       Boolean        @default(false)
  status          LocationStatus @default(ACTIVE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  company Company @relation(fields: [companyId], references: [id])
  Job     Job[]

  @@index([companyId])
  @@index([status])
  @@index([countryCode])
  @@index([isPrimary])
}

model CompanySettings {
  id                              String        @id @default(uuid())
  companyId                       String        @unique
  requireEmailVerification        Boolean       @default(true)
  allowCustomRoles                Boolean       @default(false)
  allowCandidateDataExport        Boolean       @default(false)
  defaultApplicationRetentionDays Int           @default(365)
  defaultInterviewDurationMinutes Int           @default(60)
  defaultInterviewTimezone        String        @default("UTC")
  defaultInterviewLanguage        String        @default("en")
  aiScreeningEnabled              Boolean       @default(false)
  aiInterviewEnabled              Boolean       @default(false)
  recruiterOverrideRequired       Boolean       @default(false)
  notifyRecruiterOnNewApplication Boolean       @default(true)
  notifyCandidateOnStatusChange   Boolean       @default(true)
  emailSenderName                 String?
  emailReplyTo                    String?
  brandPrimaryColor               String?
  brandSecondaryColor             String?
  dataRetentionEnabled            Boolean       @default(false)
  candidateDataRetentionDays      Int?
  interviewRecordingRetentionDays Int?
  requireJobApproval              Boolean       @default(true)
  defaultJobApproverRole          String?
  recruitersCanPublish            Boolean       @default(false)
  defaultJobVisibility            JobVisibility @default(INTERNAL)
  defaultApplicationDeadlineDays  Int?
  defaultCurrency                 String?
  salaryVisibilityDefault         Boolean       @default(false)
  allowPublicSalaryRanges         Boolean       @default(false)
  jobCodePrefix                   String?
  careersPageEnabled              Boolean       @default(false)
  externalPostingEnabled          Boolean       @default(false)
  requireAccessibilityReview      Boolean       @default(false)
  requireScreeningFairnessReview  Boolean       @default(true)
  autoArchiveClosedJobsAfterDays  Int?
  createdAt                       DateTime      @default(now())
  updatedAt                       DateTime      @updatedAt
  updatedByUserId                 String?

  company Company @relation(fields: [companyId], references: [id])
}

model CompanyInvitation {
  id              String           @id @default(uuid())
  companyId       String
  email           String
  normalizedEmail String
  roleId          String
  departmentId    String?
  jobTitle        String?
  invitedByUserId String
  tokenHash       String
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  lastSentAt      DateTime         @default(now())
  sendCount       Int              @default(1)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  company      Company            @relation(fields: [companyId], references: [id])
  role         Role               @relation(fields: [roleId], references: [id])
  department   Department?        @relation(fields: [departmentId], references: [id])
  invitedBy    User               @relation(fields: [invitedByUserId], references: [id])
  membership   CompanyMembership? @relation(fields: [membershipId], references: [id])
  membershipId String?

  @@index([companyId])
  @@index([normalizedEmail])
  @@index([status])
  @@index([expiresAt])
  @@index([invitedByUserId])
}

model DepartmentMembership {
  id                  String   @id @default(uuid())
  companyMembershipId String
  departmentId        String
  isPrimary           Boolean  @default(false)
  createdAt           DateTime @default(now())

  membership CompanyMembership @relation(fields: [companyMembershipId], references: [id])
  department Department        @relation(fields: [departmentId], references: [id])

  @@unique([companyMembershipId, departmentId])
  @@index([companyMembershipId])
  @@index([departmentId])
}

model OrganizationAuditEvent {
  id                String                     @id @default(uuid())
  companyId         String
  actorUserId       String?
  actorMembershipId String?
  eventType         OrganizationAuditEventType
  entityType        String
  entityId          String?
  description       String
  metadata          Json?
  requestId         String?
  ipAddress         String?
  occurredAt        DateTime                   @default(now())

  company Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([eventType])
  @@index([entityType])
  @@index([entityId])
  @@index([occurredAt])
}

enum JobStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHED
  PAUSED
  CLOSED
  FILLED
  CANCELLED
  ARCHIVED
}

enum JobVisibility {
  INTERNAL
  PUBLIC
  PRIVATE
  UNLISTED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
  VOLUNTEER
  FREELANCE
  APPRENTICESHIP
  OTHER
}

enum WorkplaceType {
  ON_SITE
  REMOTE
  HYBRID
  FLEXIBLE
}

enum ExperienceLevel {
  ENTRY
  JUNIOR
  MID
  SENIOR
  LEAD
  MANAGER
  DIRECTOR
  EXECUTIVE
  NOT_SPECIFIED
}

enum EducationLevel {
  NONE
  SECONDARY
  CERTIFICATE
  DIPLOMA
  ASSOCIATE
  BACHELORS
  MASTERS
  DOCTORATE
  PROFESSIONAL
  OTHER
}

enum RequirementImportance {
  REQUIRED
  PREFERRED
  OPTIONAL
}

enum SkillType {
  TECHNICAL
  SOFT
  LANGUAGE
  CERTIFICATION
  TOOL
  DOMAIN
  OTHER
}

enum ScreeningQuestionType {
  SHORT_TEXT
  LONG_TEXT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  YES_NO
  NUMBER
  DATE
  FILE
  VIDEO
  AUDIO
  URL
}

enum JobApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum JobPublicationStatus {
  NOT_PUBLISHED
  QUEUED
  PUBLISHED
  PARTIALLY_PUBLISHED
  FAILED
  UNPUBLISHED
}

enum JobCollaboratorType {
  OWNER
  RECRUITER
  HIRING_MANAGER
  INTERVIEWER
  REVIEWER
  OBSERVER
}

enum PipelineStageType {
  APPLIED
  SCREENING
  ASSESSMENT
  AI_INTERVIEW
  RECRUITER_INTERVIEW
  TECHNICAL_INTERVIEW
  FINAL_INTERVIEW
  REFERENCE_CHECK
  OFFER
  HIRED
  REJECTED
  CUSTOM
}

enum ExternalPostingProvider {
  COMPANY_CAREERS_PAGE
  LINKEDIN
  FACEBOOK
  X
  INDEED
  GLASSDOOR
  BRIGHTERMONDAY
  JOBS_UGANDA
  CUSTOM_WEBHOOK
  OTHER
}

enum JobActivityEventType {
  JOB_CREATED
  JOB_UPDATED
  JOB_DUPLICATED
  JOB_SUBMITTED_FOR_APPROVAL
  JOB_APPROVED
  JOB_REJECTED
  JOB_CHANGES_REQUESTED
  JOB_SCHEDULED
  JOB_PUBLISHED
  JOB_PUBLICATION_FAILED
  JOB_PAUSED
  JOB_RESUMED
  JOB_CLOSED
  JOB_FILLED
  JOB_CANCELLED
  JOB_ARCHIVED
  JOB_RESTORED
  COLLABORATOR_ADDED
  COLLABORATOR_UPDATED
  COLLABORATOR_REMOVED
  SCREENING_CONFIG_UPDATED
  PIPELINE_UPDATED
  TEMPLATE_CREATED
  TEMPLATE_UPDATED
  TEMPLATE_ARCHIVED
}

model Job {
  id                        String               @id @default(uuid())
  companyId                 String
  jobCode                   String
  slug                      String
  title                     String
  departmentId              String?
  locationId                String?
  employmentType            EmploymentType
  workplaceType             WorkplaceType
  experienceLevel           ExperienceLevel
  status                    JobStatus            @default(DRAFT)
  visibility                JobVisibility        @default(INTERNAL)
  approvalStatus            JobApprovalStatus    @default(NOT_REQUIRED)
  publicationStatus         JobPublicationStatus @default(NOT_PUBLISHED)
  description               String
  responsibilities          String?
  qualifications            String?
  benefits                  String?
  applicationInstructions   String?
  internalNotes             String?
  numberOfOpenings          Int                  @default(1)
  salaryMin                 Decimal?
  salaryMax                 Decimal?
  salaryCurrency            String?
  salaryPeriod              String?
  salaryVisible             Boolean              @default(false)
  remoteCountryRestrictions Json?
  applicationDeadline       DateTime?
  expectedStartDate         DateTime?
  publishedAt               DateTime?
  scheduledPublishAt        DateTime?
  closedAt                  DateTime?
  filledAt                  DateTime?
  archivedAt                DateTime?
  createdByMembershipId     String
  updatedByMembershipId     String?
  ownerMembershipId         String
  templateId                String?
  version                   Int                  @default(1)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  deletedAt                 DateTime?

  company         Company            @relation(fields: [companyId], references: [id])
  department      Department?        @relation(fields: [departmentId], references: [id])
  location        CompanyLocation?   @relation(fields: [locationId], references: [id])
  template        JobTemplate?       @relation(fields: [templateId], references: [id])
  ownerMembership CompanyMembership  @relation("JobOwner", fields: [ownerMembershipId], references: [id])
  createdBy       CompanyMembership  @relation("JobCreatedBy", fields: [createdByMembershipId], references: [id])
  updatedBy       CompanyMembership? @relation("JobUpdatedBy", fields: [updatedByMembershipId], references: [id])

  screeningConfig        JobScreeningConfiguration?
  accessibilityConfig    JobAccessibilityConfiguration?
  pipeline               JobPipeline?
  skills                 JobSkill[]
  educationRequirements  JobEducationRequirement[]
  experienceRequirements JobExperienceRequirement[]
  languageRequirements   JobLanguageRequirement[]
  screeningQuestions     JobScreeningQuestion[]
  approvals              JobApproval[]
  collaborators          JobCollaborator[]
  publications           JobPublication[]
  activityEvents         JobActivityEvent[]

  // Phase 2.2
  applications Application[]

  // Phase 2.3
  interviews Interview[]

  @@unique([companyId, jobCode])
  @@unique([companyId, slug])
  @@index([companyId])
  @@index([status])
  @@index([departmentId])
  @@index([locationId])
  @@index([ownerMembershipId])
  @@index([employmentType])
  @@index([workplaceType])
  @@index([visibility])
  @@index([publicationStatus])
  @@index([createdAt])
  @@index([applicationDeadline])
}

model JobTemplate {
  id                        String           @id @default(uuid())
  companyId                 String
  name                      String
  description               String?
  category                  String?
  departmentId              String?
  employmentType            EmploymentType?
  workplaceType             WorkplaceType?
  experienceLevel           ExperienceLevel?
