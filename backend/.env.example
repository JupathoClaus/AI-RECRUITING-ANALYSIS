# Application
APP_NAME=TalentAI
APP_VERSION=1.0.0
APP_PORT=3000
API_PREFIX=api
API_VERSION=v1
FRONTEND_URL=http://localhost:3001
REQUEST_TIMEOUT_MS=30000
HEALTH_CHECK_TIMEOUT_MS=3000

# Node
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/talentai?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=talentai:

# JWT Authentication (generate strong random strings for production)
JWT_SECRET=replace-with-strong-random-secret
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=replace-with-strong-random-refresh-secret
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=talentai-api
JWT_AUDIENCE=talentai-recruiter-web

# Auth
BCRYPT_ROUNDS=10
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=15
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_VERIFICATION_TOKEN_TTL_MINUTES=1440
AUTH_PASSWORD_RESET_TOKEN_TTL_MINUTES=30
AUTH_SESSION_LIMIT_PER_USER=10
REFRESH_TOKEN_COOKIE_NAME=talentai_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=lax

# Security
CORS_ORIGIN=http://localhost:3001
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug

# Swagger
SWAGGER_ENABLED=true
SWAGGER_TITLE=TalentAI API
SWAGGER_DESCRIPTION=Enterprise-grade AI-powered Recruitment Management Platform API
SWAGGER_VERSION=1.0.0

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# AI Screening
AI_SCREENING_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=
AI_SCREENING_TIMEOUT_MS=30000
AI_SCREENING_MAX_RESUME_CHARS=15000
AI_SCREENING_PROMPT_VERSION=v1
AI_SCREENING_SCHEMA_VERSION=v1
AI_SCREENING_WORKER_CONCURRENCY=3
AI_SCREENING_MOCK_SCENARIO=

# Resume Extraction
RESUME_EXTRACTION_MAX_FILE_BYTES=10485760
RESUME_EXTRACTION_MAX_TEXT_CHARS=50000
RESUME_EXTRACTION_MIN_TEXT_CHARS=20
RESUME_EXTRACTION_TIMEOUT_MS=30000
