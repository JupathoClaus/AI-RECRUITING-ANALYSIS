# Application
APP_NAME=TalentAI
APP_VERSION=1.0.0
APP_PORT=3000
API_PREFIX=api
API_VERSION=v1
FRONTEND_URL=http://localhost:3001
REQUEST_TIMEOUT_MS=30000
HEALTH_CHECK_TIMEOUT_MS=3000

# Node
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/talentai?schema=public

# Redis
# Hosted environments may set REDIS_URL instead of the split fields below.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=talentai:
# Hosted Redis providers such as Upstash require TLS.
REDIS_TLS=false

# JWT Authentication (generate strong random strings for production)
JWT_SECRET=replace-with-strong-random-secret
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=replace-with-strong-random-refresh-secret
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=talentai-api
JWT_AUDIENCE=talentai-recruiter-web

# Auth
BCRYPT_ROUNDS=10
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=15
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_VERIFICATION_TOKEN_TTL_MINUTES=1440
AUTH_PASSWORD_RESET_TOKEN_TTL_MINUTES=30
AUTH_SESSION_LIMIT_PER_USER=10
REFRESH_TOKEN_COOKIE_NAME=talentai_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=lax

# Security
CORS_ORIGIN=http://localhost:3001
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug

# Swagger
SWAGGER_ENABLED=true
SWAGGER_TITLE=TalentAI API
SWAGGER_DESCRIPTION=Enterprise-grade AI-powered Recruitment Management Platform API
SWAGGER_VERSION=1.0.0

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# AI Screening
# Provider options: mock | openai | deepseek | qwen
# Production safety: do NOT default to mock. Set the real provider explicitly.
AI_SCREENING_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=
AI_SCREENING_TIMEOUT_MS=30000
AI_SCREENING_MAX_RESUME_CHARS=15000
AI_SCREENING_PROMPT_VERSION=v1
AI_SCREENING_SCHEMA_VERSION=v1
AI_SCREENING_WORKER_CONCURRENCY=3
AI_SCREENING_MOCK_SCENARIO=

# Qwen provider (OpenAI-compatible endpoint â€” Ollama locally, vLLM in production)
# Local Ollama:
#   AI_SCREENING_PROVIDER=qwen
#   QWEN_BASE_URL=http://host.docker.internal:11434/v1   (from inside Docker)
#   QWEN_BASE_URL=http://localhost:11434/v1              (run directly on host)
#   QWEN_MODEL=qwen3.5:9b   (Qwen3.5-9B â€” official Ollama tag)
# Production vLLM:
#   AI_SCREENING_PROVIDER=qwen
#   QWEN_BASE_URL=https://<vllm-host>/v1
#   QWEN_MODEL=<production model name served by vLLM, e.g. Qwen3.5-9B-Instruct>
#   QWEN_API_KEY=<real API key for the vLLM endpoint>
QWEN_BASE_URL=
QWEN_MODEL=qwen3.5:9b
QWEN_API_KEY=ollama

# Resume Extraction
RESUME_EXTRACTION_MAX_FILE_BYTES=10485760
RESUME_EXTRACTION_MAX_TEXT_CHARS=50000
RESUME_EXTRACTION_MIN_TEXT_CHARS=20
RESUME_EXTRACTION_TIMEOUT_MS=30000

# Tavus AI Interviews (required values when enabled)
TAVUS_ENABLED=false
TAVUS_API_KEY=
TAVUS_PERSONA_ID=
TAVUS_REPLICA_ID=
# Public backend origin, e.g. https://api.example.com (not the frontend URL)
TAVUS_CALLBACK_BASE_URL=
TAVUS_CALLBACK_SECRET=
TAVUS_MAX_CALL_DURATION_SECONDS=600
TAVUS_PARTICIPANT_ABSENT_TIMEOUT_SECONDS=120
TAVUS_PARTICIPANT_LEFT_TIMEOUT_SECONDS=60

# ── Tavus conversation recording (optional) ─────────────────────────────────
# Recording is delivered to YOUR object storage (S3 / GCS / Azure Blob) via
# federated identity — no secrets are stored at Tavus. Configure the trust
# relationship on your side, then enable:
#   AWS S3: IAM role trusting AWS account 291871421005 with ExternalId "tavus"
#           and max session duration 43200s; bucket-scoped PutObject/GetObject.
#   GCS:    Workload Identity Federation trusting issuer https://recording-copy.tavus.io
#   Azure:  Entra ID federated credential trusting the same OIDC issuer.
# See Tavus docs: Conversation Recordings (recording_storage).
TAVUS_RECORDING_ENABLED=false
TAVUS_RECORDING_PROVIDER=s3            # s3 | gcs | azure_blob
TAVUS_RECORDING_BUCKET_NAME=
TAVUS_RECORDING_BUCKET_REGION=         # S3 only
TAVUS_RECORDING_ASSUME_ROLE_ARN=       # S3 only
TAVUS_RECORDING_PROJECT_ID=            # GCS only
TAVUS_RECORDING_WORKLOAD_IDENTITY_PROVIDER=  # GCS only
TAVUS_RECORDING_SERVICE_ACCOUNT_EMAIL= # GCS only
TAVUS_RECORDING_STORAGE_ACCOUNT=       # Azure only
TAVUS_RECORDING_CONTAINER=             # Azure only
TAVUS_RECORDING_TENANT_ID=             # Azure only
TAVUS_RECORDING_CLIENT_ID=             # Azure only
TAVUS_RECORDING_KEY_TEMPLATE=          # optional key template, e.g. tavus/{conversation_id}/{epoch_ms}.mp4

# ── AWS (secure recording playback, optional) ──────────────────────────────
# Short-lived signed S3 URLs for HR video playback. Bucket stays private.
# Identity: default AWS credential chain (env / shared profile / instance
# role) or STS AssumeRole into a least-privilege playback role.
AWS_REGION=eu-north-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=
# AWS_PLAYBACK_ROLE_ARN=
# AWS_PLAYBACK_ROLE_SESSION_NAME=ai-recruiter-playback
# AWS_PLAYBACK_SIGNED_URL_TTL_SECONDS=600
